---
// Persistent scene: sea + sky + light. Mounted once, before content.
// See docs/scene-contract.md.
---

<div class="horizon" id="horizon" data-state="init" aria-hidden="true">
  <div class="horizon__fallback"></div>
  <canvas class="horizon__canvas" id="horizon-canvas"></canvas>
</div>

<style>
  .horizon {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    contain: layout paint;
  }

  /* Visible before the first frame lands, and permanently if WebGL is
     unavailable. Dawn palette with the horizon at the height the camera
     frames it, so the page still reads as the same scene.

     Stops track the `dawn` era in horizon-eras.ts. The old version put a
     0.3%-wide step across the horizon, which drew the same hard band in the
     no-WebGL path that the shader was drawing in the WebGL one — and made the
     canvas fade-in visibly jump. The melt below the horizon is now spread over
     ~30% of the height, mirroring the haze bell the shader uses. */
  .horizon__fallback {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      #2a2b52 0%,
      #3f4068 20%,
      #6d6b95 40%,
      #a99aad 50%,
      #dcb3b8 56%,
      #e6c8c8 58.5%,
      #c6b0b8 62%,
      #8a8496 68%,
      #5c5c72 76%,
      #3e4459 86%,
      #232839 100%
    );
  }

  .horizon__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms ease;
  }

  .horizon[data-state='ready'] .horizon__canvas {
    opacity: 1;
  }

  .horizon[data-state='failed'] .horizon__canvas {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .horizon__canvas {
      transition: none;
    }
  }
</style>

<script>
  import { mountHorizon } from '../scripts/horizon'

  const boot = () => {
    try {
      mountHorizon()
    } catch {
      document.getElementById('horizon')?.setAttribute('data-state', 'failed')
    }
  }

  boot()
  document.addEventListener('astro:after-swap', boot)
</script>
