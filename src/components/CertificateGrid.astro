---
import type { Certificate } from '../lib/cv'
import { safeUrl } from './cv-format'

interface Props {
  certificates: Certificate[]
}

const { certificates } = Astro.props
---

<ul class="certs">
  {
    certificates.map((certificate) => {
      const thumb = safeUrl(certificate.image)
      return (
        <li class="cert">
          {thumb && (
            <span class="cert__thumb">
              {/* Decorative: the title sits directly beneath it. */}
              <img src={thumb} alt="" loading="lazy" decoding="async" />
            </span>
          )}
          <span class="cert__name">
            {certificate.url ? (
              <a href={certificate.url} target="_blank" rel="noopener noreferrer">
                {certificate.title}
              </a>
            ) : (
              certificate.title
            )}
          </span>
        </li>
      )
    })
  }
</ul>
