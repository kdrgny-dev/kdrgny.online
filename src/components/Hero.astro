---
import type { Home, Url } from '../lib/cv'
import HorizonRule from './HorizonRule.astro'
import { cleanHtml, safeUrl } from './cv-format'

interface Props {
  home: Home
  urls: Url[]
  span: string
}

const { home, urls, span } = Astro.props
const summary = cleanHtml(home.summary)
const portrait = safeUrl(home.photo)

// Ad harf harf belirir; ekran okuyucu bütünü h1'in aria-label'ından alır.
// lang="tr" şart: text-transform locale duyarlıdır ve İngilizce kuralı
// "Kadir"i KADIR yapar — doğrusu KADİR.
const words = home.name.split(/\s+/).filter(Boolean)
let letterIndex = -1
---

<section class="era era--hero" data-era="dawn" id="top" aria-labelledby="hero-name">
  <div class="shell stagger">
    <HorizonRule light="Dawn" span={span} />

    <div class="hero__top">
      <div class="hero__intro">
        <h1 class="display hero__name" id="hero-name" lang="tr" aria-label={home.name}>
          {
            words.map((word) => (
              <span class="hero__word" aria-hidden="true">
                {[...word].map((ch) => {
                  letterIndex += 1
                  return (
                    <span class="hero__ch" style={`--l:${letterIndex}`}>
                      {ch}
                    </span>
                  )
                })}
              </span>
            ))
          }
        </h1>

        <p class="hero__meta">
          <span class="hero__role">{home.title}</span>
          <span class="hero__where">{home.location}</span>
        </p>
      </div>

      {
        portrait && (
          <figure class="hero__portrait">
            <img
              src={portrait}
              alt={`Portrait of ${home.name}`}
              width="400"
              height="400"
              loading="eager"
              fetchpriority="high"
            />
            <span class="hero__portrait-water" aria-hidden="true">
              <img src={portrait} alt="" loading="lazy" decoding="async" />
            </span>
          </figure>
        )
      }
    </div>

    <div class="hero__body">
      <div class="panel prose hero__summary" set:html={summary} />
    </div>

    <ul class="links">
      {
        urls.map((link) => (
          <li>
            <a class="link-chip" href={link.url} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Özet kendi kendine yazılır. Metin düğümleri gezilerek her karakter kendi
  // span'ine alınır; <strong> gibi biçimlendirme olduğu yerde kalır. Script
  // çalışmazsa hiçbir şey sarılmaz ve paragraf zaten tam görünür.
  const summary = document.querySelector<HTMLElement>('.hero__summary')
  const still = window.matchMedia('(prefers-reduced-motion: reduce)')

  if (summary && !still.matches) {
    const walker = document.createTreeWalker(summary, NodeFilter.SHOW_TEXT)
    const texts: Text[] = []
    let node: Node | null = walker.nextNode()
    while (node) {
      texts.push(node as Text)
      node = walker.nextNode()
    }

    let i = 0
    for (const text of texts) {
      const frag = document.createDocumentFragment()
      for (const ch of text.data) {
        if (ch === ' ') {
          // Boşlukları sarmamak satır kırılmasını doğal bırakır.
          frag.append(ch)
          i += 1
          continue
        }
        const span = document.createElement('span')
        span.className = 'tw'
        span.style.setProperty('--i', String(i))
        span.textContent = ch
        frag.append(span)
        i += 1
      }
      text.replaceWith(frag)
    }

    summary.style.setProperty('--tw-total', String(i))
    summary.dataset.typing = 'ready'

    // Görünür olunca başlat: hero ilk ekran olsa da, geri dönüldüğünde
    // baştan akmasın diye tek seferlik.
    const start = () => summary.setAttribute('data-typing', 'run')
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              start()
              io.disconnect()
            }
          }
        },
        { threshold: 0.25 },
      )
      io.observe(summary)
    } else {
      start()
    }
  }
</script>
